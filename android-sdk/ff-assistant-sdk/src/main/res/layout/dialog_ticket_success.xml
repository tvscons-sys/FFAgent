<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_ticket_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:background="@drawable/bg_avatar"
            android:src="@drawable/ic_ticket"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ticket raised"
                android:textColor="@color/ff_ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Your request is now with the support team."
                android:textColor="@color/ff_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Reference ID"
        android:textColor="@color/ff_cyan_700"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ticketReference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_composer"
        android:fontFamily="sans-serif-medium"
        android:padding="14dp"
        android:textColor="@color/ff_ink"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/copyTicketReference"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Copy reference ID"
        android:textAllCaps="false"
        android:textColor="@color/ff_cyan_700"
        app:icon="@drawable/ic_copy"
        app:iconTint="@color/ff_cyan_700" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Our support team will get back to you shortly."
        android:textColor="@color/ff_muted"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dismissTicket"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:text="Done"
        android:textAllCaps="false"
        android:textColor="@color/ff_surface"
        app:backgroundTint="@color/ff_cyan_700"
        app:cornerRadius="18dp" />
</LinearLayout>
