<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@color/ff_background">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/ff_line"
        app:cardBackgroundColor="@color/ff_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="26dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_avatar"
                android:src="@drawable/logo_flying_flea"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:contentDescription="@string/assistant_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="FF Support Assistant"
                android:textSize="30sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="@color/ff_brand_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ask about DTCs, faults, service steps, and repair guidance."
                android:textSize="16sp"
                android:textColor="@color/ff_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/openAssistantButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Open Assistant"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:cornerRadius="18dp"
        android:backgroundTint="@color/ff_cyan_700" />
</LinearLayout>
