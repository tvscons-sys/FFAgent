<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#F4F7FB">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FF Support Assistant"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#13294B" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ask about DTCs, faults, service steps, and repair guidance."
                android:textSize="16sp"
                android:textColor="#4E5C75" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/openAssistantButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Open Assistant"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:cornerRadius="18dp"
        android:backgroundTint="#1F5EFF" />
</LinearLayout>
