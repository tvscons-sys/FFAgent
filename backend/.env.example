APP_NAME=FF AI Support Assistant API
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DATA_DIR=../data
CHROMA_PERSIST_DIRECTORY=./storage/chroma
CHROMA_COLLECTION=ff_support_documents
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HF_EMBEDDING_DEVICE=cpu
HF_NORMALIZE_EMBEDDINGS=true
HF_EMBEDDING_DIMENSION=384
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
RAG_SCORE_THRESHOLD=0.55
RAG_REQUEST_TIMEOUT_SECONDS=5
SUPPORTED_DOCUMENT_EXTENSIONS=.pdf,.docx,.txt,.md,.xlsx,.xlsm,.pptx
EXCEL_ROW_AS_CHUNK=true
EXCEL_INCLUDE_HEADERS=true
PDF_CHUNK_STRATEGY=hybrid
PDF_CHUNK_SIZE=800
PDF_CHUNK_OVERLAP=120